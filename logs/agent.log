def find_max(numbers):
    if not numbers:
        raise ValueError("Empty list")
    max_val = numbers[0]
    for num in numbers[1:]:
        if num > max_val:
            max_val = num
    return max_val

assert find_max([1, 5, 3, 9, 2]) == 9
